# Root-level ignore rules for Redis practice project

# Dependencies
node_modules/
**/node_modules/

# Environment files
.env
.env.*
**/.env
**/.env.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build output
/dist/
/build/
**/dist/
**/build/
coverage/

# Cache folders
.cache/
.parcel-cache/
.next/
.turbo/
.vite/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.local

# Temporary files
tmp/
temp/
